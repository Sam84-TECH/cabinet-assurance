# Environnement virtuel Python
venv/

# Variables d'environnement (secrets)
.env

# Caches Python
__pycache__/
*.pyc

# Cache pytest
.pytest_cache/

# Documents PDF archivés (générés côté serveur, non versionnés)
archives/

# FastAPI Cloud : lien local ↔ app déployée, créé par `fastapi deploy`
.fastapicloud/

# Artefacts de build Python (wheel/sdist, métadonnées setuptools)
build/
dist/
*.egg-info/
