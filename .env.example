# Copier ce fichier en ".env" et adapter selon l'environnement (dev local, serveur agence).
# Ce fichier n'est qu'un MODÈLE : aucune valeur secrète réelle ne doit y figurer ni être commitée.

# Connexion PostgreSQL (voir docker-compose.yml pour la base de dev, port 5433).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/cabinet

# Clé de signature des jetons JWT. OBLIGATOIRE à changer en production : générer une valeur
# longue et aléatoire, ex. : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-a-changer-en-production

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Par défaut : ports de dev locaux du frontend React. Ne jamais mettre "*" en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Fiscalité des quittances (branche auto, Maroc) — à ajuster selon la réglementation.
# Taux de taxe en % appliqué à la prime nette, et droit de timbre fixe par quittance.
TAUX_TAXE_ASSURANCE=14.00
DROIT_TIMBRE=0.00

# Recouvrement — nombre de jours après l'exigibilité de la prime au-delà duquel une
# quittance impayée bascule automatiquement en recouvrement (RF-ECH-04). Varie selon
# l'agence et la réglementation ; la tâche planifiée ouvre alors un dossier de recouvrement.
DELAI_RECOUVREMENT_JOURS=30

# Éditions PDF (RF-POL-04) — répertoire d'archivage horodaté des documents générés, et
# en-tête imprimé sur chaque document (nom du cabinet et sous-titre).
ARCHIVES_DIR=archives
NOM_CABINET=Cabinet d'assurance - Agent général Sanlam
SOUS_TITRE_CABINET=Sanlam Maroc - Branche Automobile
